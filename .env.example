# Use uma conta PostgreSQL com permissão somente de leitura.
PEC_DB_HOST=localhost
PEC_DB_PORT=5432
PEC_DB_NAME=esus
PEC_DB_USER=esus_leitura
PEC_DB_PASSWORD=troque-esta-senha
# PEC_DB_SSLMODE=require

# Como alternativa às variáveis acima:
# PEC_DB_DSN=host=localhost port=5432 dbname=esus user=esus_leitura password=troque-esta-senha

# Timeout por consulta, em milissegundos.
PEC_DB_STATEMENT_TIMEOUT_MS=30000

# stdio para clientes MCP locais (aplicativos de desktop, IDEs); streamable-http para servir na rede.
# O modo HTTP não tem autenticação: mantenha o host em 127.0.0.1.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=5174
